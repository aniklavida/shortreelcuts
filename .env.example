# Copy to `.env` to override. `docker compose up` uses these defaults as-is.

# Postgres credentials, shared by the worker and the web app inside compose.
POSTGRES_USER=shortreelcuts
POSTGRES_PASSWORD=shortreelcuts
POSTGRES_DB=shortreelcuts

# Only needed when running the web app or worker outside compose, against a
# database you run yourself. Inside compose this is derived from the values
# above and does not need setting.
# SHORTREELCUTS_DATABASE_URL=postgres://shortreelcuts:shortreelcuts@localhost:5432/shortreelcuts

# Script model connection, read by the worker once at boot. Point at any
# OpenAI-chat-completions endpoint: a hosted provider with your own key (set
# the API key too), or a local runtime such as Ollama (leave the key unset).
# The key is used only to authenticate the request; it never reaches the
# plan, the database or a log line. With no base URL and name set, the worker
# falls back to a deterministic script stub and records that it did.
# SHORTREELCUTS_MODEL_BASE_URL=https://api.example.com/v1
# SHORTREELCUTS_MODEL_NAME=your-model
# SHORTREELCUTS_MODEL_API_KEY=your-key

# Voice model connection, read by the worker once at boot. Point at any
# OpenAI-audio-speech endpoint: a hosted provider with your own key (set
# the API key too), or a local server you run (leave the key unset).
# Comma-separated voice IDs can be listed in SHORTREELCUTS_VOICE_IDS (defaults
# to standard OpenAI voice names when omitted). With no base URL and name set,
# the worker falls back to a deterministic voice stub and records that it did.
# SHORTREELCUTS_VOICE_BASE_URL=https://api.example.com/v1
# SHORTREELCUTS_VOICE_NAME=your-voice-model
# SHORTREELCUTS_VOICE_API_KEY=your-voice-key
# SHORTREELCUTS_VOICE_IDS=alloy,echo,fable,onyx,nova,shimmer

# Stock footage library, read by the worker once at boot. You choose one:
# SHORTREELCUTS_FOOTAGE_PROVIDER=pexels
# SHORTREELCUTS_FOOTAGE_PROVIDER=pixabay
# There is no default — a stock library is bring-your-own-key with no
# credential-free half, so with no provider chosen the worker falls back to
# a deterministic footage stub whose recorded reason says plainly that no
# library was searched. Naming a provider without a key is a
# misconfiguration and the worker refuses to start, rather than handing
# you a video of synthetic clip ids.
# The key is used only to authenticate the request; it never reaches the
# plan, the database or a log line. Only the library's own asset id is
# recorded in a plan, and the media URL is re-resolved from it at render
# time — a plan is exportable and shareable, so a download URL inside one
# would be a licence-redistribution leak.
# SHORTREELCUTS_FOOTAGE_API_KEY=your-free-tier-key

# Optional. Overrides the library's API root, for a caching proxy or a
# self-hosted mirror. Leave unset to reach the library's own host.
# SHORTREELCUTS_FOOTAGE_BASE_URL=https://api.example.com

# Optional. The `ffmpeg` and `ffprobe` binaries to spawn. Unset means whatever
# is on PATH. Set these if your default `ffmpeg` was not built with libass —
# burned-in captions need the `subtitles` filter, and the worker fails with a
# message saying exactly that rather than rendering a silent mistake. Homebrew's
# plain `ffmpeg` formula lacks libass; `ffmpeg-full` has it. These are only read
# when the worker runs outside compose: the compose worker service uses the
# `ffmpeg` installed in its own image, and this file is not passed into it.
# SHORTREELCUTS_FFMPEG_PATH=/usr/local/bin/ffmpeg
# SHORTREELCUTS_FFPROBE_PATH=/usr/local/bin/ffprobe

