# The pipeline runner. ffmpeg is a binary in this image, not a service.
# The repo ships TypeScript source with no build step, so the worker runs via
# tsx (MIT) the same way its tests run under vitest.
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .
RUN npm ci

ENV SHORTREELCUTS_WORKER_WORKDIR=/data/work

CMD ["npm", "run", "worker"]
